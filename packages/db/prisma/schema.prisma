// Models are added per module. Auth tables (User, Session, Account, Verification) follow the
// layout generated by the Better Auth CLI (`pnpm dlx auth@1.7.6 generate`), adjusted by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  PROJECT_MANAGER
}

/// Users are deactivated (`active = false`), never deleted.
model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          Role       @default(SALES)
  active        Boolean    @default(true)
  /// The non-login actor for jobs and imports (see M1 spec, Decision 5).
  isSystem      Boolean    @default(false)
  /// Required by the Better Auth admin plugin; unused — deactivation uses `active`.
  banned        Boolean?   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]
  enquiries     Enquiry[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required by the admin plugin; impersonation endpoints are disabled.
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// Credential accounts hold the password hash (providerId = "credential").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

/// Matches ctx.source in packages/core (CLAUDE.md rule 3).
enum AuditSource {
  web
  mcp
  import
  system
}

/// Append-only: written only by the audit extension in packages/core; a database trigger
/// rejects UPDATE and DELETE (migration m2_audit_log).
model AuditLog {
  id            String      @id @default(uuid())
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id])
  action        AuditAction
  source        AuditSource
  /// Prisma model name, e.g. "User".
  entityType    String
  entityId      String
  /// Full row before the change (credentials redacted); null for creates.
  before        Json?
  /// Full row after the change (credentials redacted); null for hard deletes.
  after         Json?
  changedFields String[]
  /// Groups the rows written by one service call (withTx).
  requestId     String
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── M3: masters and settings ───────────────────────────────────────────────
// Soft-deletable models (have `deletedAt`): reads hide deleted rows by default and
// hard deletes throw (packages/core/audit/soft-delete.ts). Case-insensitive name
// uniqueness among non-deleted rows is a partial index in migration m3_admin_masters.

/// `active = false` retires a sector (hidden from pickers); `deletedAt` removes mistakes.
model Sector {
  id        String    @id @default(uuid())
  name      String
  active    Boolean   @default(true)
  clients   Client[]
  enquiries Enquiry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("sector")
}

/// A service the company sells (e.g. Inspection). Same lifecycle as Sector.
model Service {
  id        String           @id @default(uuid())
  name      String
  active    Boolean          @default(true)
  enquiries EnquiryService[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@map("service")
}

model Client {
  id        String          @id @default(uuid())
  name      String
  sectorId  String
  sector    Sector          @relation(fields: [sectorId], references: [id])
  /// Indian GST identification number (15 characters), optional.
  gstin     String?
  address   String?
  notes     String?
  contacts  ClientContact[]
  enquiries Enquiry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([sectorId])
  @@map("client")
}

/// At most one non-deleted primary contact per client (partial unique index).
model ClientContact {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@map("client_contact")
}

/// Exactly one row (id = 1, enforced by a CHECK constraint). Base currency is fixed INR.
model CompanySettings {
  id                    Int      @id @default(1)
  companyName           String
  defaultInvoiceDueDays Int      @default(30)
  enabledCurrencies     String[] @default(["INR"])
  baseCurrency          String   @default("INR")
  updatedAt             DateTime @updatedAt

  @@map("company_settings")
}

// ─── M4: enquiries ──────────────────────────────────────────────────────────

/// Changed only by the status machine in packages/core/status/enquiry.ts (CLAUDE.md rule 8).
enum EnquiryStatus {
  IN_PROGRESS
  CONVERTED
  LOST
}

/// Where the enquiry came from (M4 Decision 10).
enum EnquirySource {
  EMAIL
  PHONE
  TENDER_PORTAL
  REFERRAL
  WEBSITE
  WALK_IN
  OTHER
}

/// CHECKs in migration m4_enquiries: proposalSentDate >= receivedDate, and CONVERTED
/// requires proposalSentDate.
model Enquiry {
  id               String           @id @default(uuid())
  /// Human-readable reference, e.g. ENQ-2026-0042 (M4 Decision 9). Immutable, never reused.
  number           String           @unique
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  /// Defaults to the client's sector in the UI; stored per enquiry (M4 Decision 3).
  sectorId         String
  sector           Sector           @relation(fields: [sectorId], references: [id])
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id])
  services         EnquiryService[]
  receivedDate     DateTime         @db.Date
  proposalSentDate DateTime?        @db.Date
  source           EnquirySource
  /// Required for TENDER_PORTAL, REFERRAL and OTHER (portal and tender ID, referrer, ...).
  sourceDetail     String?
  description      String?
  status           EnquiryStatus    @default(IN_PROGRESS)
  /// Required when LOST (M4 Decision 4).
  lostReason       String?
  statusChangedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([ownerId, status])
  @@index([clientId])
  @@index([status, receivedDate])
  @@index([source])
  @@map("enquiry")
}

/// Explicit join (M4 Decision 2) so each added or removed service is audited. Not
/// soft-deletable: removing a service is a hard DELETE with its `before` row.
model EnquiryService {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())

  @@unique([enquiryId, serviceId])
  @@index([serviceId])
  @@map("enquiry_service")
}

/// Per-prefix, per-year counters for human-readable numbers (`id` = "ENQ-2026").
/// Incremented inside the caller's transaction, so a rollback does not consume a number.
model NumberSequence {
  id        String   @id
  lastValue Int
  updatedAt DateTime @updatedAt

  @@map("number_sequence")
}
