// Models are added per module. Auth tables (User, Session, Account, Verification) follow the
// layout generated by the Better Auth CLI (`pnpm dlx auth@1.7.6 generate`), adjusted by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  PROJECT_MANAGER
}

/// Users are deactivated (`active = false`), never deleted.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(SALES)
  active        Boolean   @default(true)
  /// The non-login actor for jobs and imports (see M1 spec, Decision 5).
  isSystem      Boolean   @default(false)
  /// Required by the Better Auth admin plugin; unused — deactivation uses `active`.
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required by the admin plugin; impersonation endpoints are disabled.
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// Credential accounts hold the password hash (providerId = "credential").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

/// Matches ctx.source in packages/core (CLAUDE.md rule 3).
enum AuditSource {
  web
  mcp
  import
  system
}

/// Append-only: written only by the audit extension in packages/core; a database trigger
/// rejects UPDATE and DELETE (migration m2_audit_log).
model AuditLog {
  id            String      @id @default(uuid())
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id])
  action        AuditAction
  source        AuditSource
  /// Prisma model name, e.g. "User".
  entityType    String
  entityId      String
  /// Full row before the change (credentials redacted); null for creates.
  before        Json?
  /// Full row after the change (credentials redacted); null for hard deletes.
  after         Json?
  changedFields String[]
  /// Groups the rows written by one service call (withTx).
  requestId     String
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
