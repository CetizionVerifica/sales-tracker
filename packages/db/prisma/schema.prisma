// Models are added per module. Auth tables (User, Session, Account, Verification) follow the
// layout generated by the Better Auth CLI (`pnpm dlx auth@1.7.6 generate`), adjusted by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  PROJECT_MANAGER
}

/// Users are deactivated (`active = false`), never deleted.
model User {
  id                String        @id
  name              String
  email             String        @unique
  emailVerified     Boolean       @default(false)
  image             String?
  role              Role          @default(SALES)
  active            Boolean       @default(true)
  /// The non-login actor for jobs and imports (see M1 spec, Decision 5).
  isSystem          Boolean       @default(false)
  /// Required by the Better Auth admin plugin; unused — deactivation uses `active`.
  banned            Boolean?      @default(false)
  banReason         String?
  banExpires        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          Session[]
  accounts          Account[]
  auditLogs         AuditLog[]
  enquiries         Enquiry[]
  followUps         FollowUp[]
  quotations        Quotation[]
  managedProjects   Project[]
  uploadedDocuments Document[]    @relation("DocumentUploader")
  reviewedDocuments Document[]    @relation("DocumentReviewer")
  importBatches     ImportBatch[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required by the admin plugin; impersonation endpoints are disabled.
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// Credential accounts hold the password hash (providerId = "credential").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

/// Matches ctx.source in packages/core (CLAUDE.md rule 3).
enum AuditSource {
  web
  mcp
  import
  system
}

/// Append-only: written only by the audit extension in packages/core; a database trigger
/// rejects UPDATE and DELETE (migration m2_audit_log).
model AuditLog {
  id            String      @id @default(uuid())
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id])
  action        AuditAction
  source        AuditSource
  /// Prisma model name, e.g. "User".
  entityType    String
  entityId      String
  /// Full row before the change (credentials redacted); null for creates.
  before        Json?
  /// Full row after the change (credentials redacted); null for hard deletes.
  after         Json?
  changedFields String[]
  /// Groups the rows written by one service call (withTx).
  requestId     String
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── M3: masters and settings ───────────────────────────────────────────────
// Soft-deletable models (have `deletedAt`): reads hide deleted rows by default and
// hard deletes throw (packages/core/audit/soft-delete.ts). Case-insensitive name
// uniqueness among non-deleted rows is a partial index in migration m3_admin_masters.

/// `active = false` retires a sector (hidden from pickers); `deletedAt` removes mistakes.
model Sector {
  id         String      @id @default(uuid())
  name       String
  active     Boolean     @default(true)
  /// Grouped into "Other sectors" on the M12b sales reports, regardless of its own rank.
  isOther    Boolean     @default(false)
  clients    Client[]
  enquiries  Enquiry[]
  quotations Quotation[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@map("sector")
}

/// A service the company sells (e.g. Inspection). Same lifecycle as Sector.
model Service {
  id                 String                 @id @default(uuid())
  name               String
  active             Boolean                @default(true)
  enquiries          EnquiryService[]
  quotations         QuotationService[]
  projects           ProjectService[]
  purchaseOrders     PurchaseOrderService[]
  purchaseOrderLines PurchaseOrderLine[]
  invoices           Invoice[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  @@map("service")
}

model Client {
  id             String          @id @default(uuid())
  name           String
  sectorId       String
  sector         Sector          @relation(fields: [sectorId], references: [id])
  /// Indian GST identification number (15 characters), optional.
  gstin          String?
  address        String?
  notes          String?
  contacts       ClientContact[]
  enquiries      Enquiry[]
  followUps      FollowUp[]
  quotations     Quotation[]
  projects       Project[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  documents      Document[]
  /// Set when M10b's importer created this client; undo soft-deletes it along with the
  /// batch's other records. Never set for a client an import merely matched.
  importBatchId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([sectorId])
  @@index([importBatchId])
  @@map("client")
}

/// At most one non-deleted primary contact per client (partial unique index).
model ClientContact {
  id          String     @id @default(uuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean    @default(false)
  followUps   FollowUp[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@map("client_contact")
}

/// Exactly one row (id = 1, enforced by a CHECK constraint). Base currency is fixed INR.
model CompanySettings {
  id                        Int      @id @default(1)
  companyName               String
  defaultInvoiceDueDays     Int      @default(30)
  enabledCurrencies         String[] @default(["INR"])
  baseCurrency              String   @default("INR")
  /// Admins can stop files being sent to the Claude API (M7 Decision 6).
  documentExtractionEnabled Boolean  @default(true)
  /// An IN_PROGRESS enquiry untouched this long is stale in My Today (M11 Decision 5).
  /// CHECK 1–365 in migration m11_my_today.
  staleEnquiryDays          Int      @default(30)
  /// The date format assumed for an ambiguous import column (M10b), e.g. "DD/MM/YYYY".
  importDateFormat          String   @default("DD/MM/YYYY")
  updatedAt                 DateTime @updatedAt

  @@map("company_settings")
}

// ─── M4: enquiries ──────────────────────────────────────────────────────────

/// Changed only by the status machine in packages/core/status/enquiry.ts (CLAUDE.md rule 8).
enum EnquiryStatus {
  IN_PROGRESS
  CONVERTED
  LOST
}

/// Where the enquiry came from (M4 Decision 10).
enum EnquirySource {
  EMAIL
  PHONE
  TENDER_PORTAL
  REFERRAL
  WEBSITE
  WALK_IN
  OTHER
}

/// CHECKs in migration m4_enquiries: proposalSentDate >= receivedDate, and CONVERTED
/// requires proposalSentDate.
model Enquiry {
  id               String           @id @default(uuid())
  /// Human-readable reference, e.g. ENQ-2026-0042 (M4 Decision 9). Immutable, never reused.
  number           String           @unique
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  /// Defaults to the client's sector in the UI; stored per enquiry (M4 Decision 3).
  sectorId         String
  sector           Sector           @relation(fields: [sectorId], references: [id])
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id])
  services         EnquiryService[]
  quotations       Quotation[]
  receivedDate     DateTime         @db.Date
  proposalSentDate DateTime?        @db.Date
  source           EnquirySource
  /// Required for TENDER_PORTAL, REFERRAL and OTHER (portal and tender ID, referrer, ...).
  sourceDetail     String?
  description      String?
  status           EnquiryStatus    @default(IN_PROGRESS)
  /// Required when LOST (M4 Decision 4).
  lostReason       String?
  statusChangedAt  DateTime?
  /// Set when M10b's importer created this enquiry; undo soft-deletes it (M10b).
  importBatchId    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([ownerId, status])
  @@index([clientId])
  @@index([clientId, receivedDate])
  @@index([status, receivedDate])
  @@index([source])
  @@index([receivedDate])
  @@index([importBatchId])
  @@map("enquiry")
}

/// Explicit join (M4 Decision 2) so each added or removed service is audited. Not
/// soft-deletable: removing a service is a hard DELETE with its `before` row.
model EnquiryService {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())

  @@unique([enquiryId, serviceId])
  @@index([serviceId])
  @@map("enquiry_service")
}

/// Per-prefix, per-year counters for human-readable numbers (`id` = "ENQ-2026").
/// Incremented inside the caller's transaction, so a rollback does not consume a number.
model NumberSequence {
  id        String   @id
  lastValue Int
  updatedAt DateTime @updatedAt

  @@map("number_sequence")
}

// ─── M5: follow-ups ─────────────────────────────────────────────────────────

enum FollowUpChannel {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  WHATSAPP
  OTHER
}

/// Every pipeline record type a follow-up can be linked to. The service accepts only the
/// types whose module has shipped (M5 Decision 3; registry in follow-up-targets.ts).
enum FollowUpEntityType {
  CLIENT
  ENQUIRY
  QUOTATION
  PROJECT
  PURCHASE_ORDER
  INVOICE
}

/// A touchpoint that happened (M5 Decision 1). Linked polymorphically to a record
/// (`entityType` + `entityId`, no FK: checked by the service) and always to its client, for
/// the per-client timeline. CHECKs in migration m5_follow_ups: nextFollowUpDate >= date,
/// and a CLIENT follow-up's entityId is its clientId.
model FollowUp {
  id               String             @id @default(uuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id])
  /// The author.
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  entityType       FollowUpEntityType
  entityId         String
  /// Who at the client was spoken to; must belong to clientId.
  contactId        String?
  contact          ClientContact?     @relation(fields: [contactId], references: [id])
  /// When it happened (a calendar day, M5 Decision 7).
  date             DateTime           @db.Date
  channel          FollowUpChannel
  notes            String
  nextFollowUpDate DateTime?          @db.Date
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@index([clientId, date])
  @@index([entityType, entityId, date])
  @@index([userId, nextFollowUpDate])
  @@map("follow_up")
}

// ─── M6: quotations ─────────────────────────────────────────────────────────

/// Changed only by the status machine in packages/core/status/quotation.ts (CLAUDE.md rule 8).
/// PO_RECEIVED and LOST are terminal (M6 Decisions 9 and 11).
enum QuotationStatus {
  SENT
  UNDER_NEGOTIATION
  PO_RECEIVED
  LOST
}

/// A priced proposal for a converted enquiry. Edited in place; the audit log is the revision
/// history (M6 Decision 2). The client is always the enquiry's (M6 Decision 6). CHECKs in
/// migration m6_quotations: non-negative amount, ISO currency, next follow-up date while
/// active, PO received date when PO_RECEIVED (not before quotationDate), reason when LOST.
model Quotation {
  id                     String             @id @default(uuid())
  /// Human-readable reference, e.g. QUO-2026-0042 (M6 Decision 7). Immutable, never reused.
  number                 String             @unique
  enquiryId              String
  enquiry                Enquiry            @relation(fields: [enquiryId], references: [id])
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id])
  sectorId               String
  sector                 Sector             @relation(fields: [sectorId], references: [id])
  ownerId                String
  owner                  User               @relation(fields: [ownerId], references: [id])
  services               QuotationService[]
  /// At most one live project (partial unique index in m8_projects; M8 Decision 2).
  projects               Project[]
  quotationDate          DateTime           @db.Date
  /// Integer minor units (M6 Decision 3: BigInt, since Int caps paise at ~₹2.1 crore).
  amountMinor            BigInt
  /// ISO 4217 code; one of CompanySettings.enabledCurrencies when set.
  currency               String
  /// INR equivalent at the monthly rate for this record's own date (M12 Decision 1);
  /// null until a rate exists. CHECKs in m12_dashboard keep the pair consistent.
  amountInrMinor         BigInt?
  fxRate                 Decimal?           @db.Decimal(14, 6)
  status                 QuotationStatus    @default(SENT)
  /// Required while SENT or UNDER_NEGOTIATION; synced from the latest follow-up.
  nextFollowUpDate       DateTime?          @db.Date
  /// Synced from the latest follow-up's notes (M6 Decision 5); editable by hand.
  lastFollowUpHighlights String?
  /// The follow-up the two fields above were last synced from (no FK).
  lastFollowUpId         String?
  /// Required when PO_RECEIVED (M6 Decision 8).
  poReceivedDate         DateTime?          @db.Date
  /// Required when LOST (M6 Decision 11).
  lostReason             String?
  description            String?
  statusChangedAt        DateTime?
  /// The quotation's current document (M7 Decision 2).
  documentId             String?            @unique
  document               Document?          @relation(fields: [documentId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  @@index([ownerId, status, nextFollowUpDate])
  @@index([enquiryId])
  @@index([clientId])
  @@index([status, quotationDate])
  @@index([status, poReceivedDate])
  @@index([status, statusChangedAt])
  @@map("quotation")
}

/// Explicit join, as EnquiryService: each added or removed service is audited. Not
/// soft-deletable: removing a service is a hard DELETE with its `before` row.
model QuotationService {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([quotationId, serviceId])
  @@index([serviceId])
  @@map("quotation_service")
}

// ─── M8: projects ───────────────────────────────────────────────────────────

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// The work delivered after a quotation's PO arrives. Created from a PO_RECEIVED quotation
/// (M8 Decision 1); the client is always the quotation's (Decision 3). CHECKs in migration
/// m8_projects: non-negative revenue, ISO currency, completion 0–100, 100% and a completed
/// date when COMPLETED, a start date once started, reasons for ON_HOLD and CANCELLED, and
/// dates in order. The partial unique index "project_live_quotation_key" (one live project
/// per quotation) is SQL only: Prisma cannot express it, so keep it when editing this model.
model Project {
  id              String           @id @default(uuid())
  /// Human-readable reference, e.g. PRJ-2026-0007 (M8 Decision 8). Immutable, never reused.
  number          String           @unique
  quotationId     String
  quotation       Quotation        @relation(fields: [quotationId], references: [id])
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  /// An active PROJECT_MANAGER, or null while unassigned (M8 Decision 5).
  managerId       String?
  manager         User?            @relation(fields: [managerId], references: [id])
  services        ProjectService[]
  purchaseOrders  PurchaseOrder[]
  name            String
  /// Integer minor units (M6 Decision 3). Defaults to the quotation amount (M8 Decision 9).
  revenueMinor    BigInt
  currency        String
  /// INR equivalent at the monthly rate for this record's own date (M12 Decision 1);
  /// null until a rate exists. CHECKs in m12_dashboard keep the pair consistent.
  amountInrMinor  BigInt?
  fxRate          Decimal?         @db.Decimal(14, 6)
  status          ProjectStatus    @default(NOT_STARTED)
  statusChangedAt DateTime?
  completionPct   Int              @default(0)
  startDate       DateTime?        @db.Date
  /// The planned end.
  endDate         DateTime?        @db.Date
  /// The actual end, required when COMPLETED (M8 Decision 7).
  completedDate   DateTime?        @db.Date
  /// Required when ON_HOLD; kept after resuming (M8 Decision 11).
  holdReason      String?
  /// Required when CANCELLED (M8 Decision 12).
  cancelReason    String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([quotationId])
  @@index([managerId, status])
  @@index([clientId])
  @@index([status, endDate])
  @@index([managerId, completedDate])
  @@map("project")
}

/// Explicit join, as QuotationService: each added or removed service is audited.
model ProjectService {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, serviceId])
  @@index([serviceId])
  @@map("project_service")
}

// ─── M7: documents and extraction ───────────────────────────────────────────

/// The pipeline record a document belongs to. PURCHASE_ORDER and INVOICE ship with M9/M10.
enum DocumentKind {
  QUOTATION
  PURCHASE_ORDER
  INVOICE
}

/// Changed only by packages/core/status/document.ts (CLAUDE.md rule 8).
enum ExtractionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// CLAUDE.md rule 9: extracted values reach a record only after the user confirms.
enum DocumentReviewStatus {
  PENDING
  CONFIRMED
}

/// A file attached to a quotation, PO or invoice. `entityId` is polymorphic (no FK); the
/// document-kind registry in packages/core checks it, as FollowUp.entityId.
model Document {
  id                 String               @id @default(uuid())
  kind               DocumentKind
  entityId           String
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id])
  uploadedById       String
  uploadedBy         User                 @relation("DocumentUploader", fields: [uploadedById], references: [id])
  /// Cloudinary public_id (or the local/memory store key in tests).
  storageKey         String               @unique
  resourceType       String
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  sha256             String
  extractionStatus   ExtractionStatus     @default(QUEUED)
  extractionAttempts Int                  @default(0)
  /// User-safe message; never raw API output.
  extractionError    String?
  extractionModel    String?
  extractedAt        DateTime?
  /// Validated extraction output; a suggestion only, never read by pipeline services.
  extraction         Json?
  reviewStatus       DocumentReviewStatus @default(PENDING)
  reviewedById       String?
  reviewedBy         User?                @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  /// Fields the reviewer wrote to the record on confirm.
  appliedFields      String[]             @default([])
  quotation          Quotation?
  purchaseOrder      PurchaseOrder?
  invoice            Invoice?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  @@index([kind, entityId])
  @@index([clientId, createdAt])
  @@index([uploadedById, reviewStatus])
  @@index([extractionStatus, updatedAt])
  @@map("document")
}

// ─── M9: purchase orders ────────────────────────────────────────────────────────

/**
 * Derived from the PO's invoices (M9 Decision 4): written only by
 * recomputePurchaseOrderStatus in packages/core, never chosen by a user.
 */
enum PurchaseOrderStatus {
  PENDING
  PAID
  OVERDUE
}

/**
 * The client's order authorising billing on a project (M9). A project has many; the client
 * is always the project's (Decision 1). CHECKs in migration m9_purchase_orders: positive
 * amount, ISO currency, a 1–64 character PO number, net days 0–365. The partial unique index
 * "purchase_order_live_client_number_key" on ("clientId", lower("poNumber")) among live rows
 * (Decision 2) is SQL only: Prisma cannot express it, so keep it when editing this model.
 */
model PurchaseOrder {
  id               String                 @id @default(uuid())
  projectId        String
  project          Project                @relation(fields: [projectId], references: [id])
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id])
  /// The client's PO number as printed (Decision 2); unique per client among live POs,
  /// ignoring case.
  poNumber         String
  /// When the PO reached us (not the date printed on it; Decision 12).
  receivedDate     DateTime               @db.Date
  /// The PO total as printed, in integer minor units (Decision 6, M6 Decision 3).
  amountMinor      BigInt
  currency         String
  /// INR equivalent at the monthly rate for this record's own date (M12 Decision 1);
  /// null until a rate exists. CHECKs in m12_dashboard keep the pair consistent.
  amountInrMinor   BigInt?
  fxRate           Decimal?               @db.Decimal(14, 6)
  services         PurchaseOrderService[]
  lines            PurchaseOrderLine[]
  /// As printed or briefly summarised (Decision 7).
  paymentTerms     String?
  /// Net days when the terms state them; M10 defaults invoice due dates from it.
  paymentTermsDays Int?
  description      String?
  /// Derived; written only by recomputePurchaseOrderStatus (Decision 4).
  status           PurchaseOrderStatus    @default(PENDING)
  statusChangedAt  DateTime?
  /// The PO's current document (M7 Decision 2).
  documentId       String?                @unique
  document         Document?              @relation(fields: [documentId], references: [id])
  invoices         Invoice[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  @@index([projectId])
  @@index([clientId, receivedDate])
  @@index([receivedDate])
  @@index([status])
  @@index([clientId, poNumber])
  @@map("purchase_order")
}

/**
 * Explicit join, as ProjectService: each added or removed service is audited.
 */
model PurchaseOrderService {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([purchaseOrderId, serviceId])
  @@index([serviceId])
  @@map("purchase_order_service")
}

/**
 * One service's slice of a PO's amount (M12b): a PO with one service gets one line for the
 * full amount; several services split it (the sum must equal the PO amount, checked in
 * `packages/core`, never by a DB constraint across rows). `amountInrMinor` is the line's
 * share of the PO's own INR equivalent, converted at the PO's `fxRate` (never independently
 * rated) and kept summing to it by `purchase-order-lines.ts`. `allocationEstimated` is set
 * only by the M12b data migration, for a pre-existing multi-service PO nobody confirmed a
 * split for; the form always produces a real split for new or edited lines.
 */
model PurchaseOrderLine {
  id                  String        @id @default(uuid())
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  serviceId           String
  service             Service       @relation(fields: [serviceId], references: [id])
  amountMinor         BigInt
  currency            String
  amountInrMinor      BigInt?
  fxRate              Decimal?      @db.Decimal(14, 6)
  allocationEstimated Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([serviceId])
  @@map("purchase_order_line")
}

// ─── M10: invoices ──────────────────────────────────────────────────────────────

/// Changed only through packages/core/status/invoice.ts (CLAUDE.md rule 8). OVERDUE is set by
/// the nightly job, and on create or a due-date edit (M10 Decision 7).
enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

/// How an invoice's due date was set (M10 Decision 6): the PO's net days, the company
/// default, or typed by hand. Only MANUAL due dates stay put when the invoice date changes.
enum DueDateBasis {
  PO_TERMS
  COMPANY_DEFAULT
  MANUAL
}

/**
 * What we bill the client against one of their POs (M10). The client and currency are the
 * PO's (Decisions 1 and 3). CHECKs in migration m10_invoices: positive amount, ISO currency, a
 * 1–64 character number, due date on or after the invoice date, PAID exactly when paidAt is
 * set, and paidAt on or after the invoice date. The partial unique index
 * "invoice_live_number_key" on lower("invoiceNumber") among live rows (Decision 2) is SQL
 * only: Prisma cannot express it, so keep it when editing this model.
 */
model Invoice {
  id                 String        @id @default(uuid())
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  /// Our number from the accounting system; unique company-wide among live invoices,
  /// ignoring case (Decision 2).
  invoiceNumber      String
  invoiceDate        DateTime      @db.Date
  /// One of the PO's services (Decision 4).
  serviceId          String
  service            Service       @relation(fields: [serviceId], references: [id])
  /// The invoice total as printed, including taxes, in integer minor units (M6 Decision 3).
  amountMinor        BigInt
  /// The PO's currency, copied and fixed (Decision 3).
  currency           String
  /// INR equivalent at the monthly rate for this record's own date (M12 Decision 1);
  /// null until a rate exists. CHECKs in m12_dashboard keep the pair consistent.
  amountInrMinor     BigInt?
  fxRate             Decimal?      @db.Decimal(14, 6)
  dueDate            DateTime      @db.Date
  dueDateBasis       DueDateBasis
  status             InvoiceStatus @default(PENDING)
  statusChangedAt    DateTime?
  /// The day the payment was received; set exactly when the status is PAID.
  paidAt             DateTime?     @db.Date
  /// UTR, cheque number or other payment note.
  paymentReference   String?
  /// Why an admin last reversed a payment (Decision 8).
  unmarkedPaidReason String?
  description        String?
  /// The invoice's current document (M7 Decision 2).
  documentId         String?       @unique
  document           Document?     @relation(fields: [documentId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([purchaseOrderId])
  @@index([clientId, invoiceDate])
  @@index([status, dueDate])
  @@index([serviceId])
  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([paidAt])
  @@map("invoice")
}

// ─── M12: dashboard ─────────────────────────────────────────────────────────────

/// Admin-entered monthly exchange rates (M12 Decision 1). A record in `currency` dated in
/// `month` stores its INR equivalent at this rate. One live rate per currency and month
/// (partial unique index in migration m12_dashboard, with CHECKs: rate > 0, first of month).
model ExchangeRate {
  id         String    @id @default(uuid())
  /// ISO 4217, never INR.
  currency   String
  /// The first day of the month the rate applies to.
  month      DateTime  @db.Date
  /// INR per one unit of `currency`, exact decimal.
  inrPerUnit Decimal   @db.Decimal(14, 6)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([currency, month])
  @@map("exchange_rate")
}

// ─── M10b: bulk import ────────────────────────────────────────────────────────────
//
// Phase 1: one sheet, one entity (Enquiry), create-only — the schema below already carries
// the fields later phases need (multi-entity `entity`, `mapping`'s value-alias shape), so
// they extend this without a rewrite.

/// The record type a batch imports. Phase 1 only ever sets ENQUIRY; more join this enum as
/// later phases add them (M10b).
enum ImportEntity {
  ENQUIRY
}

/// Changed only by packages/core/import/service.ts, as the wizard moves through its steps.
enum ImportBatchStatus {
  UPLOADED
  PARSING
  MAPPING
  VALIDATING
  READY
  COMMITTING
  COMMITTED
  FAILED
  UNDONE
  EXPIRED
}

/// One spreadsheet upload working through the M10b wizard. `parsed`/`sheetConfig`/`mapping`
/// hold the wizard's state between steps so nothing is re-parsed on a page refresh; `counts`
/// is the Review step's summary (ready/warning/error/duplicate/excluded row counts).
model ImportBatch {
  id             String            @id @default(uuid())
  fileName       String
  /// Cloudinary public_id, raw and private (M10b Security).
  fileStorageKey String
  fileSize       Int
  entity         ImportEntity
  /// `{ mode: 'createOnly' }` in phase 1; grows with an update mode, historical mode, etc.
  options        Json
  parsed         Json?
  sheetConfig    Json?
  mapping        Json?
  status         ImportBatchStatus @default(UPLOADED)
  counts         Json?
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  rows           ImportRow[]
  committedAt    DateTime?
  undoneAt       DateTime?
  /// Drafts expire 7 days after creation (M10b `import.expire-drafts`).
  expiresAt      DateTime
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdById, status])
  @@index([expiresAt])
  @@map("import_batch")
}

enum ImportRowStatus {
  READY
  WARNING
  ERROR
  DUPLICATE
  EXCLUDED
}

/// One staged spreadsheet row (M10b). Working state, not a business record — excluded from
/// the audit log (packages/core/audit/model-meta.ts): re-validating a row rewrites it on
/// every edit, and nothing here is final until commit, when the created record is audited
/// normally, same as any other write.
model ImportRow {
  id              String          @id @default(uuid())
  batchId         String
  batch           ImportBatch     @relation(fields: [batchId], references: [id])
  sheetName       String
  rowNumber       Int
  /// The row's raw cell values, keyed by column header.
  original        Json
  /// After transform (dates/text normalised); null until the Columns step runs.
  transformed     Json?
  /// After resolve (client id, sector id, owner id, ...); null until validated.
  resolved        Json?
  status          ImportRowStatus @default(READY)
  /// `{ field, code, message }[]`.
  messages        Json            @default("[]")
  /// `{ enquiryId, clientId }` once committed; read by undo.
  resultRecordIds Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([batchId, status])
  @@map("import_row")
}
