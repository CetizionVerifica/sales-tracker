{
  "name": "@sales-tracker/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts",
    "./schemas": "./schemas/index.ts",
    "./status": "./status/index.ts",
    "./auth-cookie": "./auth/cookie.ts",
    "./errors": "./errors.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "seed:documents": "tsx --env-file-if-exists=../../.env scripts/seed-documents.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@sales-tracker/db": "workspace:*",
    "better-auth": "1.7.6",
    "bullmq": "6.3.9",
    "cloudinary": "2.11.0",
    "ioredis": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  }
}
