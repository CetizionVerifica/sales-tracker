{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "CLOUDINARY_*", "WEB_PORT", "MCP_PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "TEST_DATABASE_URL", "BETTER_AUTH_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
