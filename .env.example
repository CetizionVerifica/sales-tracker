NODE_ENV=development

# Postgres (docker compose)
DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker
TEST_DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker_test

# Redis (docker compose)
REDIS_URL=redis://localhost:6380

# Cloudinary file storage. No local emulator: use a separate dev Cloudinary account
# (Settings > API Keys). Placeholders are fine until M7 uploads files.
CLOUDINARY_CLOUD_NAME=your-dev-cloud-name
CLOUDINARY_API_KEY=your-dev-api-key
CLOUDINARY_API_SECRET=your-dev-api-secret
# Optional folder prefix for uploads (default sales-tracker/<NODE_ENV>).
# CLOUDINARY_FOLDER=sales-tracker/development

# Document storage and extraction (M7). Production must use cloudinary + claude.
#   FILE_STORE: cloudinary | local (temp folder shared by web and worker; E2E) | memory (Vitest)
#   EXTRACTOR:  claude | mock (fixtures keyed by file hash; tests and E2E)
FILE_STORE=cloudinary
EXTRACTOR=claude

# Claude API for document extraction. Required in production; without it in development,
# each extraction fails with "Document reading is not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Largest upload in bytes (default 20 MB, max 30 MB).
DOCUMENT_MAX_BYTES=20971520

WEB_PORT=3000
MCP_PORT=3001

# Better Auth. Generate a real secret with: openssl rand -base64 36
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (pnpm db:seed). Dev-only values; use real ones anywhere shared.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# With NODE_ENV=development the seed also creates dev-only users:
#   sales@example.com / sales-dev-password   (SALES)
#   sales2@example.com / sales2-dev-password (SALES)
#   pm@example.com    / pm-dev-password1     (PROJECT_MANAGER)

# Reverse proxies in front of the app (comma-separated IPs/CIDRs), e.g. 10.0.0.0/8.
# Required in production behind a proxy so sign-in rate limits are per client.
TRUSTED_PROXY_CIDRS=

# Sign-in attempts per minute per client IP (default 5). Only raise it for automated tests.
AUTH_SIGNIN_RATE_LIMIT=5
