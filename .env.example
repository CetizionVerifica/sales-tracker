NODE_ENV=development

# Postgres (docker compose)
DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker
TEST_DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker_test

# Redis (docker compose)
REDIS_URL=redis://localhost:6380

# S3-compatible storage (MinIO in docker compose)
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-south-1
S3_BUCKET=sales-tracker
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

WEB_PORT=3000
MCP_PORT=3001
