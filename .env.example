NODE_ENV=development

# Postgres (docker compose)
DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker
TEST_DATABASE_URL=postgresql://sales:sales@localhost:5440/sales_tracker_test

# Redis (docker compose)
REDIS_URL=redis://localhost:6380

# S3-compatible storage (MinIO in docker compose)
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-south-1
S3_BUCKET=sales-tracker
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

WEB_PORT=3000
MCP_PORT=3001

# Better Auth. Generate a real secret with: openssl rand -base64 36
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (pnpm db:seed). Dev-only values; use real ones anywhere shared.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# With NODE_ENV=development the seed also creates dev-only users:
#   sales@example.com / sales-dev-password   (SALES)
#   sales2@example.com / sales2-dev-password (SALES)
#   pm@example.com    / pm-dev-password1     (PROJECT_MANAGER)

# Reverse proxies in front of the app (comma-separated IPs/CIDRs), e.g. 10.0.0.0/8.
# Required in production behind a proxy so sign-in rate limits are per client.
TRUSTED_PROXY_CIDRS=

# Sign-in attempts per minute per client IP (default 5). Only raise it for automated tests.
AUTH_SIGNIN_RATE_LIMIT=5
